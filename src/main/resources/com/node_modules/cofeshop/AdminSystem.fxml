<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <VBox prefWidth="250" style="-fx-background-color: #f0f0f0;">
            <HBox alignment="CENTER" prefHeight="130" style="-fx-background-color: #707070;">
                <Label text="POINT OF SALE" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </HBox>
            <Button fx:id="dashboardBtn" maxWidth="Infinity" styleClass="menu-button" text="Dashboard">
                <VBox.margin>
                    <Insets top="1.0" />
                </VBox.margin>
                <padding>
                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                </padding>
            </Button>
            <Button fx:id="productBtn" maxWidth="Infinity" styleClass="menu-button" text="Product">
                <padding>
                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                </padding>
            </Button>
            <Button fx:id="orderBtn" maxWidth="Infinity" styleClass="menu-button" text="Order">
                <padding>
                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                </padding>
            </Button>
        </VBox>
    </left>
    <center>
        <StackPane>
            <AnchorPane fx:id="dashboardPane" visible="true">
                <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <HBox spacing="15.0">
                        <VBox alignment="CENTER" prefHeight="150.0" prefWidth="300.0" style="-fx-background-color: #707070; -fx-background-radius: 10;">
                            <Label text="Total pembelian" textFill="WHITE">
                                <font>
                                    <Font name="System Bold" size="16.0" />
                                </font>
                            </Label>
                            <Label fx:id="totalPembelianLabel" text="Rp. 0" textFill="WHITE">
                                <font>
                                    <Font size="24.0" />
                                </font>
                            </Label>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="150.0" prefWidth="300.0" style="-fx-background-color: #707070; -fx-background-radius: 10;">
                            <Label text="Total penjualan" textFill="WHITE">
                                <font>
                                    <Font name="System Bold" size="16.0" />
                                </font>
                            </Label>
                            <Label fx:id="totalPenjualanLabel" text="Rp. 0" textFill="WHITE">
                                <font>
                                    <Font size="24.0" />
                                </font>
                            </Label>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="150.0" prefWidth="300.0" style="-fx-background-color: #707070; -fx-background-radius: 10;">
                            <Label text="Stock tersedia" textFill="WHITE">
                                <font>
                                    <Font name="System Bold" size="16.0" />
                                </font>
                            </Label>
                            <Label fx:id="stockTersediaLabel" text="0" textFill="WHITE">
                                <font>
                                    <Font size="24.0" />
                                </font>
                            </Label>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="150.0" prefWidth="300.0" style="-fx-background-color: #707070; -fx-background-radius: 10;">
                            <Label text="Stock tidak tersedia" textFill="WHITE">
                                <font>
                                    <Font name="System Bold" size="16.0" />
                                </font>
                            </Label>
                            <Label fx:id="stockTidakTersediaLabel" text="0" textFill="WHITE">
                                <font>
                                    <Font size="24.0" />
                                </font>
                            </Label>
                        </VBox>
                    </HBox>
                </VBox>
            </AnchorPane>
            <AnchorPane fx:id="productPane" visible="false">
                <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Produk" styleClass="page-title">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="addProductBtn" text="Tambah Produk" styleClass="action-button" />
                    </HBox>
                    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="productIdColumn" text="ID" prefWidth="75" />
                            <TableColumn fx:id="productNameColumn" text="Nama Produk" prefWidth="250" />
                            <TableColumn fx:id="productPriceColumn" text="Harga" prefWidth="150" />
                            <TableColumn fx:id="productStockColumn" text="Stock" prefWidth="100" />
                            <TableColumn fx:id="productActionColumn" text="Aksi" prefWidth="150" />
                        </columns>
                    </TableView>
                </VBox>
            </AnchorPane>
            <AnchorPane fx:id="orderPane" visible="false">
                <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Order" styleClass="page-title">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="newOrderBtn" text="Buat Order Baru" styleClass="action-button" />
                    </HBox>
                    <VBox spacing="15.0" style="-fx-background-color: #0d3b49; -fx-background-radius: 10;" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <VBox HBox.hgrow="ALWAYS">
                                <TableView fx:id="orderItemTable" minHeight="300.0" maxHeight="450.0">
                                    <columns>
                                        <TableColumn fx:id="itemNameColumn" text="Item List" prefWidth="400.0" />
                                        <TableColumn fx:id="qtyColumn" text="qty" prefWidth="100.0" />
                                        <TableColumn fx:id="priceColumn" text="Price" prefWidth="150.0" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                                    <padding>
                                        <Insets top="10.0" />
                                    </padding>
                                    <Button fx:id="addItemBtn" text="Tambah Item" styleClass="action-button" />
                                    <Button fx:id="removeItemBtn" text="Hapus Item" styleClass="delete-button" />
                                </HBox>
                            </VBox>
                            <VBox alignment="TOP_CENTER" spacing="10.0" style="-fx-background-color: #c0c0c0; -fx-background-radius: 10;" minWidth="350.0">
                                <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                </padding>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Res" styleClass="receipt-label">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="resNumberLabel" text="Res/18743/20 mei 2025" styleClass="receipt-value" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="TotalPrice" styleClass="receipt-label">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="totalPriceLabel" text="Rp. 150.000" styleClass="receipt-value" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Amount" styleClass="receipt-label">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="amountField" text="Rp. 150.000" 
                                        styleClass="receipt-input" prefWidth="150.0" alignment="CENTER_RIGHT"
                                        disable="true" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Metode Pembayaran" styleClass="receipt-label">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS" />
                                   <ComboBox fx:id="paymentMethodCombo" prefWidth="150.0" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Potongan" styleClass="receipt-label">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="potonganLabel" text="2%" styleClass="receipt-value" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Kembalian" styleClass="receipt-label">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="kembalianLabel" text="0" styleClass="receipt-value" />
                                </HBox>
                                <Region VBox.vgrow="ALWAYS" />
                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                    <Button fx:id="cancelBtn" text="Cancel" styleClass="cancel-button" />
                                    <Button fx:id="konfirmasiBtn" text="Konfirmasi" styleClass="confirm-button" />
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
            </AnchorPane>
        </StackPane>
    </center>
</BorderPane>